{                                                                                                                                                                                                                                                                                                                
  "permissions": {                                                                                                                                                                                                                                                                                               
    "deny": [                                                                                                                                                                                                                                                                                                    
      "Edit",                                                                                                                                                                                                                                                                                                    
      "Write",                                                                                                                                                                                                                                                                                                   
      "NotebookEdit",                                                                                                                                                                                                                                                                                            
      "Bash(cmake --build:*)",                                                                                                                                                                                                                                                                                   
      "Bash(cmake --install:*)",                                                                                                                                                                                                                                                                                 
      "Bash(ctest:*)",                                                                                                                                                                                                                                                                                           
      "Bash(bin/RTracer.exe:*)",                                                                                                                                                                                                                                                                                 
      "Bash(bin/Test.exe:*)",                                                                                                                                                                                                                                                                                    
      "Bash(./bin/RTracer.exe:*)",                                                                                                                                                                                                                                                                               
      "Bash(./bin/Test.exe:*)"                                                                                                                                                                                                                                                                                   
    ],                                                                                                                                                                                                                                                                                                           
    "allow": [                                                                                                                                                                                                                                                                                                   
      "Read",                                                                                                                                                                                                                                                                                                    
      "Grep",                                                                                                                                                                                                                                                                                                    
      "Glob",                                                                                                                                                                                                                                                                                                    
      "Bash(git status:*)",                                                                                                                                                                                                                                                                                      
      "Bash(git log:*)",                                                                                                                                                                                                                                                                                         
      "Bash(git diff:*)",                                                                                                                                                                                                                                                                                        
      "Bash(git show:*)"                                                                                                                                                                                                                                                                                         
    ]                                                                                                                                                                                                                                                                                                            
  }                                                                                                                                                                                                                                                                                                              
}